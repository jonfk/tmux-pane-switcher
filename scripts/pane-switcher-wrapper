#!/usr/bin/env bash
set -euo pipefail

cli_bin="$(tmux show-option -gqv '@pane-switcher-cli' || true)"
if [[ -z "${cli_bin}" ]]; then
  cli_bin="${TPS_CLI_BIN:-tmux-pane-switcher}"
fi

if ! command -v "${cli_bin}" >/dev/null 2>&1; then
  tmux display-message "tmux-pane-switcher CLI not found; set @pane-switcher-cli or install tmux-pane-switcher"
  exit 1
fi

if [[ $# -gt 0 && "$1" == "jump" ]]; then
  shift

  if ! output="$("${cli_bin}" list-ranked --limit 1 --format jump-target "$@" 2>&1)"; then
    tmux display-message "${output}"
    exit 1
  fi

  if [[ -z "${output}" ]]; then
    tmux display-message "No ranked tmux pane available"
    exit 1
  fi

  IFS=$'\t' read -r server_key session_id window_id pane_id <<< "${output}"

  if [[ -z "${server_key}" || -z "${session_id}" || -z "${window_id}" || -z "${pane_id}" ]]; then
    tmux display-message "Invalid jump target output from tmux-pane-switcher"
    exit 1
  fi

  tmux -S "${server_key}" switch-client -t "${session_id}"
  tmux -S "${server_key}" select-window -t "${window_id}"
  tmux -S "${server_key}" select-pane -t "${pane_id}"
  exit 0
fi

if ! output="$("${cli_bin}" "$@" 2>&1)"; then
  tmux display-message "${output}"
  exit 1
fi

if [[ $# -gt 0 && "$1" == "observe" && -n "${output}" ]]; then
  tmux display-message "${output}"
fi

exit 0
