#!/usr/bin/env bash
set -euo pipefail

current_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cli_bin="$(tmux show-option -gqv '@pane-switcher-cli' || true)"
if [[ -z "${cli_bin}" ]]; then
  cli_bin="${TPS_CLI_BIN:-tmux-pane-switcher}"
fi

jump_limit="$(tmux show-option -gqv '@pane-switcher-jump-limit' || true)"
if [[ -z "${jump_limit}" ]]; then
  jump_limit="${TPS_JUMP_LIMIT:-200}"
fi

if ! command -v "${cli_bin}" >/dev/null 2>&1; then
  tmux display-message "tmux-pane-switcher CLI not found; set @pane-switcher-cli or install tmux-pane-switcher"
  exit 1
fi

shell_join() {
  local joined
  printf -v joined '%q ' "$@"
  printf '%s' "${joined% }"
}

decode_picker_field() {
  printf '%b' "$1"
}

jump_to_target() {
  local socket_path="$1"
  local session_id="$2"
  local window_id="$3"
  local pane_id="$4"

  if [[ -z "${socket_path}" || -z "${session_id}" || -z "${window_id}" || -z "${pane_id}" ]]; then
    tmux display-message "Invalid jump target output from tmux-pane-switcher"
    exit 1
  fi

  tmux -S "${socket_path}" switch-client -t "${session_id}"
  tmux -S "${socket_path}" select-window -t "${window_id}"
  tmux -S "${socket_path}" select-pane -t "${pane_id}"
}

open_jump_picker() {
  if ! command -v fzf >/dev/null 2>&1; then
    tmux display-message "fzf not found; install fzf to use pane jump picker"
    exit 1
  fi

  local popup_command
  popup_command="$(shell_join "${current_dir}/pane-switcher-wrapper" jump --fzf-picker "$@")"

  if ! tmux display-popup -E -T "Pane Switcher" -w "85%" -h "60%" "${popup_command}"; then
    tmux display-message "Unable to open pane switcher picker"
    exit 1
  fi
}

run_jump_picker() {
  if ! command -v fzf >/dev/null 2>&1; then
    tmux display-message "fzf not found; install fzf to use pane jump picker"
    exit 1
  fi

  local picker_output
  if ! picker_output="$("${cli_bin}" list-ranked --limit "${jump_limit}" --format picker "$@" 2>&1)"; then
    tmux display-message "${picker_output}"
    exit 1
  fi

  if [[ -z "${picker_output}" ]]; then
    tmux display-message "No ranked tmux pane available"
    exit 1
  fi

  local selection
  if ! selection="$(
    {
      printf '\t\t\t\tCommand\tSession:Pane\tWindow\tTitle\n'
      printf '%s\n' "${picker_output}"
    } | fzf \
      --delimiter=$'\t' \
      --with-nth=5.. \
      --nth=5.. \
      --header-lines=1 \
      --prompt='Jump pane> ' \
      --no-sort \
      --layout=reverse
  )"; then
    exit 0
  fi

  local socket_path session_id window_id pane_id
  IFS=$'\t' read -r socket_path session_id window_id pane_id _ <<< "${selection}"
  jump_to_target \
    "$(decode_picker_field "${socket_path}")" \
    "$(decode_picker_field "${session_id}")" \
    "$(decode_picker_field "${window_id}")" \
    "$(decode_picker_field "${pane_id}")"
}

if [[ $# -gt 0 && "$1" == "jump" ]]; then
  shift

  if [[ $# -gt 0 && "$1" == "--fzf-picker" ]]; then
    shift
    run_jump_picker "$@"
    exit 0
  fi

  open_jump_picker "$@"
  exit 0
fi

if ! output="$("${cli_bin}" "$@" 2>&1)"; then
  tmux display-message "${output}"
  exit 1
fi

if [[ $# -gt 0 && "$1" == "observe" && -n "${output}" ]]; then
  tmux display-message "${output}"
fi

exit 0
